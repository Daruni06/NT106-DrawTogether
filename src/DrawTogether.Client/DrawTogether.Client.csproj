<!-- Project WinForms cho ung dung client. -->
<!-- Sau khi tao project that bang Visual Studio, file nay se chua cau hinh build va reference toi Shared. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>WinExe</OutputType>
    <TargetFramework>net8.0-windows</TargetFramework>
    <UseWindowsForms>true</UseWindowsForms>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DrawTogether.Shared\DrawTogether.Shared.csproj" />
  </ItemGroup>
</Project>
