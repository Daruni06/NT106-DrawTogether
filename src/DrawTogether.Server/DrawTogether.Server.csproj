<!-- Project drawing server chay TCP socket va lam viec voi MySQL. -->
<!-- Sau khi tao project that, reference toi DrawTogether.Shared va MySqlConnector. -->
<Project Sdk="Microsoft.NET.Sdk">
  <PropertyGroup>
    <OutputType>Exe</OutputType>
    <TargetFramework>net8.0</TargetFramework>
    <ImplicitUsings>enable</ImplicitUsings>
    <Nullable>enable</Nullable>
  </PropertyGroup>
  <ItemGroup>
    <ProjectReference Include="..\DrawTogether.Shared\DrawTogether.Shared.csproj" />
    <PackageReference Include="MySqlConnector" Version="2.4.0" />
  </ItemGroup>
</Project>
